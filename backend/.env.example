# AI Quiz Generator - Backend Environment Variables
PORT=5000
# Enter your Google Gemini API key below (get free from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model choice: gemini-2.5-flash, gemini-1.5-flash, or gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash
# Optional CORS Origin (default: * in development)
CLIENT_ORIGIN=http://localhost:5173
